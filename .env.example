# Required runtime values are injected by the deployment secret manager.
DISCORD_BOT_TOKEN=
WISEMAN_DISCORD_ALLOWLIST=
TEMPORAL_ADDRESS=temporal:7233
PHOENIX_API_KEY=
PHOENIX_PROMPT_HUB_URL=
WISEMAN_RUNNER_API_TOKEN=
OPENROUTER_API_KEY=
WISEMAN_REPLAY_TOKEN=
WISEMAN_MODEL=
WISEMAN_PROVIDER=
WISEMAN_ROUTE_INFO={}

# Optional platform endpoints.
PHOENIX_OTLP_ENDPOINT=https://phoenix.example.com/v1/traces
PHOENIX_PROJECT=wiseman-v2
OPENROUTER_URL=https://openrouter.ai
# Empty uses the pinned CLI bundled by openai-codex.
WISEMAN_CODEX_BIN=
WISEMAN_ALLOW_PROFILE_EDITS=0
