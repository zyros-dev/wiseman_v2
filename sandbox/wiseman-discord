#!/usr/bin/env python3
import argparse
import base64
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

MAX_BYTES = 8 * 1024 * 1024


def _post(route: str, payload: dict[str, object]) -> dict[str, object]:
    base = os.getenv("WISEMAN_RELAY_URL", "").rstrip("/")
    token = os.getenv("WISEMAN_MCP_TOKEN", os.getenv("WISEMAN_PROVIDER_TOKEN", ""))
    if not base or not token:
        raise RuntimeError("wiseman-discord is not configured")  # noqa: TRY003
    request = urllib.request.Request(
        f"{base}{route}",
        data=json.dumps(payload).encode(),
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:  # noqa: S310
            value = json.load(response)
    except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError) as exc:
        raise RuntimeError(f"gateway request failed: {exc}") from exc  # noqa: TRY003
    if not isinstance(value, dict):
        raise TypeError("gateway returned invalid JSON")  # noqa: TRY003
    return value


def _file(value: str) -> tuple[Path, bytes]:
    path = Path(value).expanduser().resolve()
    root = Path.cwd().resolve()
    shared = (root / "shared").resolve()
    if path != root and root not in path.parents and path != shared and shared not in path.parents:
        raise RuntimeError("file must be inside the current thread workspace")  # noqa: TRY003
    if not path.is_file() or path.stat().st_size > MAX_BYTES:
        raise RuntimeError("file is missing or exceeds the 8 MiB upload limit")  # noqa: TRY003
    return path, path.read_bytes()


def main() -> int:
    parser = argparse.ArgumentParser(prog="wiseman-discord")
    commands = parser.add_subparsers(dest="command", required=True)
    upload = commands.add_parser("send-file")
    upload.add_argument("path")
    upload.add_argument("--caption", default="")
    image = commands.add_parser("describe-image")
    image.add_argument("url")
    image.add_argument("--question", default="")
    reactions = commands.add_parser("set-reactions")
    for phase in ("processing", "success", "failure"):
        reactions.add_argument(f"--{phase}")
    profile = commands.add_parser("set-profile")
    profile.add_argument("--username")
    profile.add_argument("--avatar")
    args = parser.parse_args()
    try:
        if args.command == "send-file":
            path, data = _file(args.path)
            result = _post("/tools/send-file", {"thread_id": os.getenv("WISEMAN_THREAD_ID", ""), "filename": path.name, "caption": args.caption[:2_000], "data_base64": base64.b64encode(data).decode()})  # noqa: E501
        elif args.command == "describe-image":
            result = _post("/tools/describe-image", {"url": args.url, "question": args.question[:2_000], "thread_id": os.getenv("WISEMAN_THREAD_ID", "")})  # noqa: E501
        elif args.command == "set-reactions":
            result = _post("/tools/set-reactions", {phase: getattr(args, phase) for phase in ("processing", "success", "failure") if getattr(args, phase) is not None})  # noqa: E501
        else:
            avatar = base64.b64encode(_file(args.avatar)[1]).decode() if args.avatar else None
            result = _post("/tools/set-profile", {key: value for key, value in (("username", args.username), ("avatar_base64", avatar)) if value is not None})
    except (OSError, RuntimeError, TypeError) as exc:
        print(f"wiseman-discord failed: {exc}", file=sys.stderr)  # noqa: T201
        return 1
    print(result.get("text", "") if args.command == "describe-image" else json.dumps(result, sort_keys=True))  # noqa: T201,E501
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
