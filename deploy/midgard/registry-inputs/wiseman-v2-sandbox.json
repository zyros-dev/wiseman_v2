{
  "name": "wiseman-v2-sandbox",
  "image": "registry.odin.home:5000/wiseman-v2-sandbox",
  "tag": "REPLACED_BY_RELEASE",
  "port": 8090,
  "host": "",
  "exposure": "internal",
  "deploy_host": "thor",
  "mem_mi": 4096,
  "storage_mi": 4096,
  "storage_mount_path": "/workspaces",
  "metrics_path": "/metrics",
  "run_as_user": 0,
  "run_as_group": 0,
  "fs_group": 0,
  "trusted": true,
  "health": "/healthz",
  "secrets": ["wiseman-v2-sandbox"],
  "env": {
    "WISEMAN_WORKSPACE_ROOT": "/workspaces",
    "WISEMAN_MANAGE_ACCOUNTS": "1",
    "WISEMAN_RELAY_URL": "http://wiseman-v2-gateway.midgard-apps.svc.cluster.local:8080/v1",
    "WISEMAN_CODEX_BIN": "/usr/local/bin/codex-as-user",
    "WISEMAN_MODEL": "deepseek/deepseek-v4-flash",
    "WISEMAN_MAX_CONCURRENT_TURNS": "4"
  }
}
